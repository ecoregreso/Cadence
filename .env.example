# GEMINI_API_KEY: Required for Gemini AI API calls (script generation, AI voiceovers, executive reports, optional Omni Flash video & Lyria music).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GITHUB_TOKEN: Optional personal access token for higher GitHub API rate limits or private repository ingestion.
GITHUB_TOKEN=""

# AWS_REGION / AWS_S3_BUCKET: Optional AWS S3 media redundancy target for exported video archives.
AWS_REGION="us-east-1"
AWS_S3_BUCKET="cadence-studio-media-archive"
